{
  "name": "service-dependency-and-deployment-manager",
  "version": "1.0.0",
  "description": "A graph-driven, bounded-concurrency deployment manager for learning production-safe scheduling.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dependency-graph",
    "deployment",
    "fastify",
    "scheduler",
    "topological-sort"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@prometheus-io/client": "^0.16.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
